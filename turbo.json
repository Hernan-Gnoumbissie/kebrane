{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "db:generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["db:generate", "^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "db:generate", "^db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate", "^db:generate"]
    },
    "smoke": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
