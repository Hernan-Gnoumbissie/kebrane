# apps/kebrane — copier vers .env.local (jamais commité).

# --- Clerk (MÊME application que GermanPass — SSO partagé) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/hub
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/hub

# Webhook Clerk du COMPTE Kebrane (KB-17) — dashboard Clerk > Webhooks.
# Endpoint : <hub>/api/webhooks/clerk · événements : user.created, user.deleted.
# ⚠ Endpoint DISTINCT de celui de GermanPass : deux abonnements, deux secrets.
# Sans ce secret, la route rejette tout (400) et seul le lazy-link crée le compte.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- SSO sous-domaines (KB-10) ---
# Topologie retenue : sous-domaines d'un même domaine racine → UNE instance
# Clerk, cookie de session sur `.kebrane.com`, aucune config « satellite ».
# En dev, localhost:3000 et localhost:3001 partagent déjà leurs cookies.
NEXT_PUBLIC_KEBRANE_HUB_URL=http://localhost:3001
NEXT_PUBLIC_GERMANPASS_URL=http://localhost:3000
# EN PRODUCTION seulement : origine du Frontend API Clerk, ajoutée à la CSP.
# CLERK_FRONTEND_API_ORIGIN=https://clerk.kebrane.com

# --- Base Kebrane (Core) — même PostgreSQL que @kebrane/db ---
# `apps/kebrane` n'a pas de base « produit » : DATABASE_URL suffirait (repli),
# mais on nomme explicitement pour rester homogène avec les apps produit.
KEBRANE_DATABASE_URL="postgresql://kebrane:kebrane_dev_password@localhost:55433/kebrane?schema=public"

# --- Bootstrap du premier administrateur (KB-20) ---
# Le compte CRÉÉ pour cet email naît ADMIN — de quoi amorcer admin.kebrane.com
# quand aucun admin n'existe encore pour en promouvoir un autre.
# ⚠ Appliqué à la seule CRÉATION du compte, jamais à la connexion : sinon une
# variable oubliée ici re-promouvrait en silence un compte rétrogradé.
# Un compte déjà existant se promeut plutôt avec :
#   pnpm --filter @kebrane/core grant-admin <email> [MEMBER|STAFF|ADMIN]
# Adresse NOMINATIVE sur le domaine — jamais une adresse partagée type admin@ :
# le journal doit pouvoir dire QUI a changé un prix (KB-13).
# KEBRANE_BOOTSTRAP_ADMIN_EMAIL=hernan@kebrane.com

# --- Notifications transactionnelles (KB-14/KB-21) ---
# Sans SMTP_HOST, la plateforme reste sur le canal « console » : les
# notifications sont journalisées, pas envoyées. C'est le bon comportement en
# développement — on voit qu'un message serait parti sans écrire à personne.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur de la MAISON (le hub), distinct de celui des produits : GermanPass
# écrit depuis germanpass.io, la plateforme depuis kebrane.com.
KEBRANE_SMTP_FROM="Kebrane <no-reply@kebrane.com>"
