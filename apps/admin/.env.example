# apps/admin — console d'administration (KB-15). Copier vers .env.local.

# --- Clerk (MÊME application que le hub et les produits — SSO partagé) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# Pas de NEXT_PUBLIC_CLERK_SIGN_UP_URL : on ne s'inscrit pas au personnel.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# --- URLs de la plateforme ---
NEXT_PUBLIC_KEBRANE_ADMIN_URL=http://localhost:3002
# Le hub figure dans les origines de redirection : c'est là qu'un membre du
# personnel active sa double authentification avant de revenir ici.
NEXT_PUBLIC_KEBRANE_HUB_URL=http://localhost:3001
# EN PRODUCTION : origine du Frontend API Clerk, ajoutée à la CSP.
# CLERK_FRONTEND_API_ORIGIN=https://clerk.kebrane.com

# --- Base Kebrane (Core) ---
KEBRANE_DATABASE_URL="postgresql://kebrane:kebrane_dev_password@localhost:55433/kebrane?schema=public"

# --- Accès ---
# Aucune variable ne donne l'accès : il faut le rôle STAFF ou ADMIN sur le
# compte Kebrane (KB-20) ET la double authentification activée chez Clerk.
#   pnpm --filter @kebrane/core grant-admin <email> STAFF
# ⚠ La 2FA est vérifiée côté serveur auprès de Clerk à chaque requête. Si Clerk
# est injoignable, l'accès est REFUSÉ : sur une console d'administration,
# l'indisponibilité d'un contrôle ne vaut pas autorisation.

# --- Notifications transactionnelles (KB-14/KB-21) ---
# La console d'administration route les mêmes événements que le hub : si elle
# tourne sans SMTP, les alertes destinées au personnel resteront en console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
KEBRANE_SMTP_FROM="Kebrane <no-reply@kebrane.com>"
