{
  "name": "@kebrane/germanpass",
  "version": "0.1.0",
  "private": true,
  "description": "GermanPass - Plateforme d'apprentissage de l'allemand et de simulation d'examens Goethe / OSD / TELC / ECL (A1-C2)",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "gen-icons": "node scripts/gen-icons.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "kebrane:backfill": "tsx scripts/kebrane-backfill.ts",
    "db:studio": "prisma studio",
    "worker": "tsx src/worker/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.0",
    "@kebrane/core": "workspace:*",
    "@kebrane/ui": "workspace:*",
    "@prisma/client": "^6.5.0",
    "@tailwindcss/typography": "^0.5.15",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "idb": "^8.0.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.8.0",
    "next": "^16.2.9",
    "nodemailer": "^8.0.11",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@kebrane/config": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@serwist/next": "^9.0.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.49",
    "prisma": "^6.5.0",
    "serwist": "^9.0.11",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
