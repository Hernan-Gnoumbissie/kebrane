# ============================================================
# GermanPass — variables d'environnement
# Copier vers .env et remplir. Aucun secret ne doit être commité.
# ============================================================

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="GermanPass"

# --- Base de données MÉTIER GermanPass (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql://daf:daf_dev_password@localhost:5432/daf_saas?schema=public

# --- Plateforme Kebrane (KB-08) ---
# Base CORE (compte Kebrane, registre produits, accès, événements). DISTINCTE de
# DATABASE_URL ci-dessus : sans cette variable, le pont vers @kebrane/core est
# désactivé (GermanPass fonctionne en autonomie, sans remontée vers le hub).
# Dev monorepo : service `postgres` de kebrane/docker-compose.yml (port 55433).
KEBRANE_DATABASE_URL=postgresql://kebrane:kebrane_dev_password@localhost:55433/kebrane?schema=public
# Gating par l'accès produit Core. 0 = observation (GermanPass reste la source
# de vérité de l'accès) ; 1 = refus opposable. À passer à 1 avec KB-13 (billing).
KEBRANE_ACCESS_ENFORCE=0
# Enveloppe IA de l'offre achetée (KB-13). 0 = observation : le dépassement est
# journalisé mais l'appel a lieu ; 1 = refus opposable.
# ⚠ NE PAS passer à 1 tant que les coûts n'ont pas été MESURÉS. Les estimations
# de `lib/kebrane.ts` ont été posées sans aucune correction en base : si elles
# sont trop hautes, un membre payant serait bloqué bien avant son dû.
# Séquence : laisser en 0 → quelques dizaines de corrections réelles →
# `pnpm --filter @kebrane/germanpass ai:cost` → ajuster les enveloppes → puis 1.
KEBRANE_AI_BUDGET_ENFORCE=0

# --- SSO sous-domaines (KB-10) ---
# Topologie retenue : sous-domaines d'un même domaine racine → UNE instance
# Clerk, cookie de session sur `.kebrane.com`, aucune config « satellite ».
# En dev, localhost:3000 et localhost:3001 partagent déjà leurs cookies.
NEXT_PUBLIC_KEBRANE_HUB_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL inscrite dans le registre produits Core (seed : pnpm --filter @kebrane/core seed).
GERMANPASS_URL=http://localhost:3000
# EN PRODUCTION seulement : origine du Frontend API Clerk, ajoutée à la CSP.
# CLERK_FRONTEND_API_ORIGIN=https://clerk.kebrane.com
# Uniquement si le hub et le produit vivent sur des domaines racines DIFFÉRENTS
# (mode satellite Clerk). Laisser absent en topologie sous-domaines.
# NEXT_PUBLIC_CLERK_IS_SATELLITE=true
# NEXT_PUBLIC_CLERK_DOMAIN=germanpass.com

# --- Redis (cache, rate-limit, queue) ---
REDIS_URL=redis://localhost:6379

# --- Clerk (socle d'identité Kebrane) ---
# Depuis le dashboard Clerk > API Keys. Configurer Google en "Social Connection" côté Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Écrans hébergés/prebuilt : on garde les chemins actuels
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Secret de vérification du webhook (dashboard Clerk > Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- IA texte (API OpenAI-compatible) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_GENERATION=gpt-4o
AI_MODEL_EVALUATION=gpt-4o
# Modèle de vision pour l'OCR des copies manuscrites (Schreiben sur papier).
VISION_MODEL=gpt-4o
AI_MODEL_EMBEDDING=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Plafond mensuel par défaut par utilisateur (en USD, coupure douce)
AI_MONTHLY_BUDGET_USER_USD=5

# --- IA audio ---
# TTS pour Hören (OpenAI-compatible /audio/speech)
TTS_MODEL=tts-1
# Dialogues Hoeren multi-voix. Seuls les modeles recents acceptent le parametre
# `instructions`, qui dirige l'intonation personnage par personnage. Les
# flashcards et les lecons restent sur TTS_MODEL, moins cher.
TTS_DIALOGUE_MODEL=gpt-4o-mini-tts
# STT pour Sprechen (OpenAI-compatible /audio/transcriptions)
STT_MODEL=whisper-1

# --- Emails (SMTP via Nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Le produit écrit depuis SON domaine, pas depuis kebrane.com : le client a
# acheté GermanPass, un expéditeur inconnu de lui paraîtrait suspect. Logique
# « By Kebrane » — le produit devant, la maison derrière.
# ⚠ SPF, DKIM et DMARC doivent être posés sur germanpass.io, sinon ces messages
# partent en indésirables — et un compte dont l'email de vérification n'arrive
# pas ne devient jamais client. Panne silencieuse, longue à diagnostiquer.
SMTP_FROM="GermanPass <no-reply@germanpass.io>"

# --- Moyens de paiement affichés sur /pricing (laisser vide pour masquer) ---
# Numéro Orange Money (ex. +237 6XX XX XX XX)
PAYMENT_ORANGE_MONEY=
# Numéro MTN Mobile Money (ex. +237 6XX XX XX XX)
PAYMENT_MTN_MOMO=
# Lien PayPal.me ou adresse e-mail PayPal
PAYMENT_PAYPAL=

# --- Stockage fichiers (hors webroot) ---
STORAGE_DIR=./storage

# --- Sécurité ---
# bcrypt rounds
BCRYPT_ROUNDS=12
# Anti-bruteforce : essais max / durée verrou (secondes)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# --- Seed (prisma/seed.ts) ---
# OBLIGATOIRE en production avant db:seed (sinon le script plante).
# Adresse nominative, jamais partagée (voir KEBRANE_BOOTSTRAP_ADMIN_EMAIL).
# SEED_ADMIN_EMAIL=hernan@kebrane.com
# SEED_ADMIN_PASSWORD=VotreMotDePasseAdmin!

# --- Sauvegardes ---
BACKUP_DIR=/var/backups/germanpass
BACKUP_ENCRYPTION_KEY=changeme
BACKUP_RETENTION_DAYS=30

# --- CD (GitHub Actions secrets, jamais en local) ---
# DEPLOY_SSH_HOST=
# DEPLOY_SSH_USER=
# DEPLOY_SSH_KEY=


# --- PayDunya (PSP mobile money, KB-13) ---
# PSP retenu le 2 sept. 2026 (KPay ecarte : immatriculation + verif URL exigees).
# Sans ces cles, l'adaptateur n'est pas enregistre et on reste sur le filet
# manuel (preuve de paiement + validation admin).
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
# URLs de retour du payeur et endpoint IPN (callback serveur-a-serveur).
PAYDUNYA_RETURN_URL=http://localhost:3000/paiement/retour
PAYDUNYA_CANCEL_URL=http://localhost:3000/paiement/annule
PAYDUNYA_CALLBACK_URL=http://localhost:3000/api/webhooks/paydunya
# Optionnel : nom/accroche affiches sur la page de paiement hebergee.
PAYDUNYA_STORE_NAME=GermanPass
PAYDUNYA_STORE_TAGLINE=Prepare ton allemand, ou que tu sois.


# --- Fapshi (PSP mobile money, KB-13) — agregateur unique MTN + Orange ---
# Retenu le 3 sept. 2026 en remplacement de PayDunya (qui ne couvre pas Orange
# Money au Cameroun). Sans ces cles, l'adaptateur n'est pas enregistre et on
# reste sur le filet manuel. Cles apikey/apiuser depuis le dashboard Fapshi.
FAPSHI_API_KEY=
FAPSHI_API_USER=
FAPSHI_MODE=sandbox
FAPSHI_REDIRECT_URL=http://localhost:3000/paiement/retour
# Optionnel : secret de webhook (header x-wh-secret) configure sur le dashboard.
FAPSHI_WEBHOOK_SECRET=
