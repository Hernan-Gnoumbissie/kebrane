{
  "name": "@kebrane/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./notifications-smtp": "./src/notifications-smtp.ts"
  },
  "scripts": {
    "seed": "tsx --env-file-if-exists=../db/.env scripts/seed.ts",
    "grant-admin": "tsx --env-file-if-exists=../db/.env scripts/grant-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=../db/.env --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@kebrane/db": "workspace:*",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "@kebrane/config": "workspace:*",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
