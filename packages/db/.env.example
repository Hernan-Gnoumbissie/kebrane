# @kebrane/db — copier vers .env (jamais commité).
# Correspond au service postgres de docker-compose.yml à la racine du monorepo.
#
# Variable DÉDIÉE à la base Core (et pas `DATABASE_URL`) : chaque produit garde
# `DATABASE_URL` pour SA base métier (GermanPass -> daf_saas:55432). Le client
# Core lit `KEBRANE_DATABASE_URL` en priorité, avec repli sur `DATABASE_URL`
# pour les apps sans base produit (apps/kebrane).
KEBRANE_DATABASE_URL="postgresql://kebrane:kebrane_dev_password@localhost:55433/kebrane?schema=public"
