// @kebrane/db — schéma Prisma central Kebrane (un seul PostgreSQL).
// Phase 2 : socle Core (compte unique, registre produits, accès, événements).
// Frontière v0.2 : les produits n'accèdent à ce domaine QUE via @kebrane/core.

// Sortie DÉDIÉE (et non le `@prisma/client` par défaut) : le monorepo est en
// `node-linker=hoisted`, il n'existe donc qu'un seul `node_modules/@prisma/client`
// pour tout le dépôt. Deux schémas (Core + GermanPass) qui y génèrent s'écrasent
// l'un l'autre au dernier `prisma generate`. GermanPass garde `@prisma/client`,
// Core prend `@kebrane/prisma-client`.
//
// La sortie vise le node_modules racine (comme le fait `@prisma/client` par
// défaut) pour rester résolvable PAR SON NOM : c'est ce qui permet à Next de
// l'externaliser (`serverExternalPackages`) au lieu de le bundler — un client
// Prisma bundlé casse la résolution du moteur de requêtes.
generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@kebrane/prisma-client"
}

// Variable dédiée (et NON `DATABASE_URL`) : les produits de la maison ont leur
// propre base métier sur `DATABASE_URL` (ex. GermanPass -> daf_saas:55432).
// Sans variable distincte, un produit qui importe @kebrane/core taperait sur SA
// base au lieu de la base Core. Voir packages/db/src/index.ts.
datasource db {
  provider = "postgresql"
  url      = env("KEBRANE_DATABASE_URL")
}

/// Compte Kebrane — identité unique « un compte, tous les produits ».
/// L'identité Clerk (clerkUserId) est liée à ce compte, source de vérité métier.
model Account {
  id String @id @default(cuid())
  /// NULLABLE à dessein (KB-17) : quand Clerk émet `user.deleted`, on DÉLIE le
  /// compte au lieu de le supprimer — l'historique métier (accès, événements,
  /// facturation à venir) doit survivre à la disparition de l'identité Clerk.
  /// Une réinscription avec le même email re-relie le compte existant.
  clerkUserId String?  @unique
  email       String   @unique
  name        String
  role        Role     @default(MEMBER)
  /// Dernier passage constaté (KB-15). Distinct d'`updatedAt`, que n'importe
  /// quelle écriture technique modifie : ici on veut « quand cette personne
  /// s'est-elle servie de la plateforme », pas « quand la ligne a-t-elle bougé ».
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accesses ProductAccess[]
  events   Event[]
  payments Payment[]

  @@map("accounts")
}

enum Role {
  MEMBER
  STAFF
  ADMIN
}

/// Registre des produits de la maison Kebrane (isolation métier par product_id).
/// Chaque produit = une couleur d'accent (charte : « une couleur de conteneur par produit »).
model Product {
  id          String        @id @default(cuid())
  slug        String        @unique // ex. "germanpass"
  name        String // ex. "GermanPass"
  tagline     String? // accroche courte
  accentColor String? // HEX de l'accent produit (cadre Marine/Rouge)
  url         String? // URL/sous-domaine du produit
  status      ProductStatus @default(COMING_SOON)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  accesses ProductAccess[]
  payments Payment[]
  plans    Plan[]
  metrics  ProductMetric[]

  @@map("products")
}

/// Offre vendue pour un produit (KB-13) — ce qu'un membre achète.
///
/// En base et non dans le code, pour que l'administrateur puisse fixer prix et
/// composition sans redéploiement. Mais les CLÉS de capacités, elles, restent
/// définies dans le code (`packages/core/src/capabilities.ts`) : la base décide
/// de ce qui est *vendu*, le code de ce qui *existe*. Sans cette limite, l'écran
/// d'administration dérive en moteur de règles et plus personne ne sait ce qu'une
/// offre donne réellement.
model Plan {
  id          String  @id @default(cuid())
  productId   String
  slug        String // "decouverte", "intensif", …
  name        String
  description String?

  /// Prix dans la plus petite unité de la devise (XAF : 1 = 1 F).
  priceAmount Int
  currency    String @default("XAF")
  /// Durée d'accès ouverte par un paiement confirmé.
  durationDays Int

  /// Clés de capacités incluses — voir `CAPABILITIES` côté code.
  capabilities String[]

  /// Enveloppe IA, en MICRO-DOLLARS (1 000 000 = 1 $).
  ///
  /// L'unité est le dollar, pas un « point » maison : c'est déjà celle que
  /// mesure `AiUsage.costUsd` côté produit, et elle reste juste quand le tarif
  /// d'un modèle change. Ce qu'on affiche au membre (« 40 corrections
  /// incluses ») est un calcul, pas un stockage.
  aiBudgetMicroUsd Int @default(0)

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([productId, slug])
  @@map("plans")
}

enum ProductStatus {
  ACTIVE
  COMING_SOON
  DISABLED
}

/// Accès d'un compte à un produit (statut/plan lus par le hub).
model ProductAccess {
  id        String       @id @default(cuid())
  accountId String
  productId String
  status    AccessStatus @default(NONE)
  plan      String?

  /// Fin de l'accès payant. `null` = pas d'échéance (accès manuel, gratuit).
  expiresAt DateTime?

  /// RECOPIE des capacités de l'offre au moment de l'achat (KB-13).
  ///
  /// Recopiées, et non lues à travers `Plan` : un administrateur qui modifie la
  /// composition d'une offre ne doit pas changer ce qu'un membre a déjà payé.
  /// C'est l'erreur classique de ce genre de système, et elle est pénible à
  /// rattraper une fois des paiements réels en base.
  capabilities String[]

  /// Enveloppe IA accordée et déjà consommée, en micro-dollars.
  aiBudgetMicroUsd Int @default(0)
  aiUsedMicroUsd   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([accountId, productId])
  @@map("product_access")
}

enum AccessStatus {
  NONE
  PENDING
  ACTIVE
  SUSPENDED
}

/// Journal d'événements/activité à 3 gravités (catalogue v0.2).
model Event {
  id        String        @id @default(cuid())
  type      String // ex. "account.created", "product.opened"
  severity  EventSeverity @default(INFO)
  accountId String?
  productId String?
  data      Json?
  createdAt DateTime      @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([type])
  @@map("events")
}

enum EventSeverity {
  INFO
  IMPORTANT
  ACTION_REQUIRED
}

/// Encaissement pour l'accès à un produit (KB-13).
///
/// Volontairement AGNOSTIQUE du fournisseur : `provider` est une chaîne, pas un
/// enum, pour qu'ajouter un PSP ne demande pas de migration. C'est la même
/// intention que l'interface `PaymentProvider` côté services — changer de
/// fournisseur ne doit toucher que l'adaptateur.
///
/// La ligne est CONSERVÉE quel que soit son sort (échec, remboursement) : c'est
/// la trace comptable, et le support en a besoin pour répondre « où est passé
/// mon argent ».
model Payment {
  id        String @id @default(cuid())
  accountId String
  productId String
  /// Slug de l'offre souscrite ; recopié dans `ProductAccess.plan`.
  plan      String
  /// Offre référencée quand elle existe au catalogue. Nullable : un
  /// encaissement manuel peut précéder la mise au catalogue, et une offre
  /// retirée ne doit pas effacer l'historique comptable.
  planId    String?

  /// RECOPIE de ce que l'offre donnait AU MOMENT DE L'ACHAT. C'est cette copie
  /// qui fait foi, pas l'offre courante — sinon modifier un pack changerait
  /// rétroactivement ce que des membres ont payé.
  capabilities     String[]
  aiBudgetMicroUsd Int      @default(0)

  /// Montant dans la PLUS PETITE unité de la devise. Le franc CFA n'a pas de
  /// subdivision (1 XAF = 1), mais on garde un entier générique pour ne pas
  /// avoir à migrer si une devise à centimes arrive un jour. Jamais de flottant
  /// pour de l'argent.
  amount   Int
  currency String @default("XAF")

  /// Fournisseur d'encaissement : "manual-proof", "kpay", "fapshi"…
  provider String
  /// Référence CHEZ le fournisseur. Couplée à `provider`, elle porte
  /// l'idempotence : un webhook rejoué ne peut pas encaisser deux fois.
  providerRef String
  channel     PaymentChannel
  /// Numéro mobile money payeur — donnée personnelle, à ne jamais journaliser en clair.
  phone       String?

  status      PaymentStatus @default(PENDING)
  confirmedAt DateTime?
  /// Charge utile du fournisseur (webhook, preuve) — pour le support et l'audit.
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  planRef   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRef])
  @@index([accountId])
  @@index([status])
  @@map("payments")
}

/// Canal d'encaissement — le MOYEN, indépendamment du fournisseur qui l'opère.
///
/// `PAYPAL` n'est pas un oubli du modèle mobile money : GermanPass prépare des
/// départs pour l'Allemagne, et une part des abonnements est financée par de la
/// famille déjà sur place, qui n'a ni MTN ni Orange. Sans ce canal, ces
/// paiements tomberaient en `MANUAL` et la part venant de la diaspora
/// deviendrait invisible dans les comptes.
///
/// `MANUAL` reste le filet de lancement (preuve de paiement + validation admin),
/// opérationnel pendant l'intégration du PSP.
enum PaymentChannel {
  MTN_MOMO
  ORANGE_MONEY
  PAYPAL
  MANUAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

/// Indicateur publié par un produit vers la plateforme (KB-15).
///
/// Générique À DESSEIN — une clé, une valeur, une date. Certaines données de
/// pilotage (progression pédagogique, taux de réussite…) vivent chez le produit
/// et n'ont rien à faire dans le domaine transversal : Core ne saurait pas les
/// calculer sans connaître le métier, ce qui casserait la frontière v0.2.
/// Le produit les CALCULE et les PUBLIE ; Core ne fait que les conserver.
///
/// Sans ce modèle, chaque nouvel indicateur produit demanderait une migration.
model ProductMetric {
  id         String   @id @default(cuid())
  productId  String
  /// Clé stable, préfixée par domaine : "progression.moyenne", "exam.reussite"…
  key        String
  value      Float
  /// Libellé et unité pour l'affichage — le produit sait ce que sa mesure veut
  /// dire, la console d'administration ne le devine pas.
  label      String?
  unit       String?
  capturedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([capturedAt])
  @@map("product_metrics")
}
